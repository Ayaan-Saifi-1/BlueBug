# .env.example — Template for environment variables
# Copy this file to .env and fill in real values
# KABHI BHAI REAL .env ko git me commit mat karna

# Django
SECRET_KEY=your-very-long-random-secret-key-here
LOG_LEVEL=WARNING

# Database (dev me SQLite, prod me PostgreSQL URL)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Allowed hosts (comma separated)
# ALLOWED_HOSTS=api.bluebug.xyz,www.api.bluebug.xyz

# CORS — frontend domains
# CORS_ALLOWED_ORIGINS=https://bluebug.xyz,https://www.bluebug.xyz

# Sentry — error monitoring (optional but recommended for prod)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxxx

# Email (SMTP) — for prod notifications
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=noreply@bluebug.xyz
